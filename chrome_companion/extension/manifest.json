{
  "manifest_version": 3,
  "name": "Lumina Chrome Companion",
  "version": "0.2.0",
  "description": "Companion for owner-granted site reading and session navigation in this Chrome profile. PAUSE LUMINA stops it.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage", "alarms", "webNavigation"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Lumina Companion" }
}
